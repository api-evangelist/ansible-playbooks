{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ansible Automation Controller Playbooks Auth Users API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{controller_host}/api/v2/users/",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List users"
        },
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{controller_host}/api/v2/users/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a user"
        }
      ]
    }
  ],
  "bundled": true
}